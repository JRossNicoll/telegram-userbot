# =============================================================================
# Telegram MTProto Userbot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Telegram API Credentials ---
# Obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890
TELEGRAM_SESSION_NAME=userbot_session

# --- AI Provider Configuration ---
# Supported: "openai" or "anthropic"
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Personality ---
# System prompt that defines the bot's personality
PERSONALITY_PROMPT=You are a helpful and friendly person chatting on Telegram. Keep responses natural, concise, and conversational. Use casual language appropriate for chat.

# --- Behavior Settings ---
# Response delay range in seconds (non-linear distribution)
MIN_RESPONSE_DELAY=3
MAX_RESPONSE_DELAY=25

# Probability of ignoring a message (0.0 to 1.0)
IGNORE_RATE=0.15

# Number of recent messages to include as context
CONTEXT_WINDOW_SIZE=10

# --- Rate Limiting ---
# Maximum messages per minute per chat
RATE_LIMIT_PER_CHAT=5
# Cooldown between responses to the same user (seconds)
USER_COOLDOWN_SECONDS=30
# Global maximum messages per minute
GLOBAL_RATE_LIMIT=20

# --- Trigger Configuration ---
# Keywords that trigger a response (comma-separated)
TRIGGER_KEYWORDS=hey,help,question,ask

# Whether to respond to direct/private messages
RESPOND_TO_DM=true

# Whether to respond when mentioned (@username)
RESPOND_TO_MENTIONS=true

# --- Activity Hours (24h format, UTC) ---
# Bot will be less active outside these hours
ACTIVE_HOURS_START=8
ACTIVE_HOURS_END=23

# --- Logging ---
LOG_LEVEL=INFO

# --- Database ---
DATABASE_PATH=data/userbot.db
